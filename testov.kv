#:import dp kivy.metrics.dp

<Label>:
    font_name: 'AppArial'
    italic: False

<Button>:
    font_name: 'AppArial'
    italic: False


<Login>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: max(self.minimum_height, root.height)
            padding: dp(28), dp(24), dp(28), dp(30)
            spacing: dp(12)

            Image:
                source: 'assets/logo.png'
                size_hint_y: None
                height: dp(120)
                fit_mode: 'contain'

            Label:
                text: 'ТехПрофи'
                color: .08, .07, .06, 1
                font_size: '31sp'
                bold: True
                size_hint_y: None
                height: dp(44)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Label:
                text: 'Beta'
                color: .45, .35, .25, 1
                font_size: '14sp'
                bold: True
                size_hint_y: None
                height: dp(24)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: name
                hint_text: 'Фамилия и инициалы'
                font_name: 'AppArial'
                font_size: '18sp'
                multiline: False
                size_hint_y: None
                height: dp(58)
                foreground_color: 0, 0, 0, 1
                background_normal: ''
                background_active: ''
                background_color: 1, 1, 1, 1
                padding: [dp(14), (self.height - self.line_height) / 2 - dp(2)]
                on_text: root.update_admin_state()

            Label:
                id: msg
                text: ''
                color: .75, .10, .10, 1
                font_size: '14sp'
                size_hint_y: None
                height: dp(34) if self.text else 0.01
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'

            Button:
                text: 'Контрольное тестирование'
                color: .08, .07, .06, 1
                font_size: '17sp'
                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1
                size_hint_y: None
                height: dp(60)
                on_release: root.start('контроль')

            Button:
                text: 'Обучение'
                color: .08, .07, .06, 1
                font_size: '17sp'
                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1
                size_hint_y: None
                height: dp(60)
                on_release: root.start('обучение')

            Button:
                text: 'Настройки'
                color: (.08, .07, .06, 1) if root.admin_enabled else (.42, .42, .42, 1)
                background_normal: ''
                background_down: ''
                background_color: (.83, .73, .61, 1) if root.admin_enabled else (.70, .68, .64, 1)
                disabled: not root.admin_enabled
                size_hint_y: None
                height: dp(56)
                on_release: root.open_settings()


<Test>:

    canvas.before:
        Color:
            rgba: .965, .935, .875, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(14), dp(48), dp(14), dp(30)
        spacing: dp(10)

        # Верхняя фиксированная область
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(214) if app.mode == 'контроль' else dp(96)
            padding: dp(16), dp(14)
            spacing: dp(8)

            canvas.before:
                Color:
                    rgba: .945, .905, .84, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]

            BoxLayout:
                size_hint_y: None
                height: dp(34)

                Label:
                    text: 'Контрольное тестирование' if app.mode == 'контроль' else 'Обучение'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: root.progress
                    color: .08, .07, .06, 1
                    font_size: '15sp'
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(10)

                canvas.before:
                    Color:
                        rgba: .78, .76, .72, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(5)]

                    Color:
                        rgba: .62, .48, .34, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.width * root.progress_ratio, self.height
                        radius: [dp(5)]

            Label:
                text: root.progress_percent
                color: .28, .23, .19, 1
                font_size: '13sp'
                size_hint_y: None
                height: dp(18)
                halign: 'right'
                valign: 'middle'
                text_size: self.size

            # Таймер есть только в контрольном режиме
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(104) if app.mode == 'контроль' else 0.01
                opacity: 1 if app.mode == 'контроль' else 0
                disabled: app.mode != 'контроль'
                spacing: dp(3)

                BoxLayout:
                    size_hint_y: None
                    height: dp(72)
                    size_hint_x: None
                    width: min(dp(285), self.parent.width)
                    pos_hint: {'center_x': .5}
                    padding: dp(13), dp(8)
                    spacing: dp(10)

                    canvas.before:
                        Color:
                            rgba: .985, .965, .925, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    canvas.after:
                        Color:
                            rgba: .55, .43, .31, 1
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
                            width: 1.2

                    Widget:
                        size_hint_x: None
                        width: dp(46)

                        canvas:
                            Color:
                                rgba: .12, .105, .09, 1
                            Line:
                                circle: (self.center_x, self.center_y, dp(15))
                                width: 1.5
                            Line:
                                points: (self.center_x, self.center_y, self.center_x, self.center_y + dp(9))
                                width: 1.6
                            Line:
                                points: (self.center_x, self.center_y, self.center_x - dp(6), self.center_y - dp(4))
                                width: 1.6

                    Label:
                        text: root.timer
                        color: .08, .07, .06, 1
                        font_size: '34sp'
                        bold: True
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size

                Label:
                    text: 'Осталось времени' if app.mode == 'контроль' else ''
                    color: .35, .29, .24, 1
                    font_size: '13sp'
                    size_hint_y: None
                    height: dp(20)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

        # Только эта часть прокручивается
        ScrollView:
            id: question_scroll
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(2), dp(4), dp(2), dp(16)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: question_label.texture_size[1] + dp(34)
                    padding: dp(14), dp(12)

                    canvas.before:
                        Color:
                            rgba: .99, .98, .96, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(13)]

                    Label:
                        id: question_label
                        text: root.question
                        color: .08, .07, .06, 1
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        font_size: '19sp'
                        bold: True
                        halign: 'left'
                        valign: 'middle'

                BoxLayout:
                    id: answers
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                Label:
                    text: root.message
                    color: .65, .15, .10, 1
                    font_size: '15sp'
                    text_size: self.width - dp(8), None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(14) if root.message else 0.01
                    halign: 'left'
                    valign: 'middle'

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if root.source else 0.01
                    opacity: 1 if root.source else 0
                    padding: dp(16), dp(14)
                    spacing: dp(8)

                    canvas.before:
                        Color:
                            rgba: (.93, .93, .92, 1) if root.source else (0, 0, 0, 0)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: 'Источник' if root.source else ''
                        color: .08, .07, .06, 1
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1] + dp(4) if root.source else 0.01
                        text_size: self.width, None
                        halign: 'left'
                        valign: 'middle'

                    Label:
                        text: root.source
                        font_name: 'Roboto'
                        color: .16, .15, .14, 1
                        font_size: '14sp'
                        size_hint_y: None
                        height: self.texture_size[1] + dp(8) if root.source else 0.01
                        text_size: self.width, None
                        halign: 'left'
                        valign: 'top'

        # Нижние кнопки всегда фиксированы
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(176) if app.mode == 'обучение' else dp(126)
            spacing: dp(8)
            padding: 0, dp(4), 0, 0

            canvas.before:
                Color:
                    rgba: .965, .935, .875, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: 'Ответ'
                color: 1, .98, .95, 1
                font_size: '15sp'
                bold: True
                background_normal: ''
                background_down: ''
                background_color: .48, .36, .25, 1
                size_hint_y: None
                height: dp(50) if app.mode == 'обучение' else 0.01
                opacity: 1 if app.mode == 'обучение' else 0
                disabled: app.mode != 'обучение'
                on_release: root.show_correct()

            Button:
                text: 'Завершить тестирование'
                color: .30, .22, .17, 1
                font_size: '14sp'
                background_normal: ''
                background_down: ''
                background_color: .90, .82, .73, 1
                size_hint_y: None
                height: dp(46)
                on_release: root.finish()

            BoxLayout:
                size_hint_y: None
                height: dp(60)
                spacing: dp(10)

                Button:
                    text: '‹  Предыдущий'
                    color: .08, .07, .06, 1
                    font_size: '15sp'
                    background_normal: ''
                    background_down: ''
                    background_color: .86, .81, .74, 1
                    disabled: root.idx <= 0
                    on_release: root.prev()

                Button:
                    text: 'Следующий  ›'
                    color: 1, .98, .95, 1
                    font_size: '15sp'
                    bold: True
                    background_normal: ''
                    background_down: ''
                    background_color: .48, .36, .25, 1
                    on_release: root.next()


<Result>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(28), dp(40), dp(28), dp(40)
        spacing: dp(18)

        Widget:

        Label:
            text: root.text
            color: .08, .07, .06, 1
            font_size: '21sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        Button:
            text: 'На главный экран'
            color: .08, .07, .06, 1
            font_size: '16sp'
            background_normal: ''
            background_down: ''
            background_color: .83, .73, .61, 1
            size_hint_y: None
            height: dp(58)
            on_release: app.root.current = 'login'

        Widget:


<AdminSettings>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(18), dp(34), dp(18), dp(20)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(52)

            Button:
                text: '‹'
                font_size: '30sp'
                color: .08, .07, .06, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                size_hint_x: None
                width: dp(48)
                on_release: root.go_back()

            Label:
                text: 'Настройки Beta'
                color: .08, .07, .06, 1
                font_size: '24sp'
                bold: True
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: None
                width: dp(48)

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(2), dp(6), dp(2), dp(20)

                Label:
                    text: 'Источники вопросов'
                    color: .08, .07, .06, 1
                    font_size: '19sp'
                    bold: True
                    size_hint_y: None
                    height: dp(34)
                    text_size: self.width, None
                    halign: 'left'

                BoxLayout:
                    size_hint_y: None
                    height: dp(52)
                    spacing: dp(8)
                    padding: dp(8), 0

                    canvas.before:
                        Color:
                            rgba: .91, .86, .78, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]

                    CheckBox:
                        id: all_sources
                        size_hint_x: None
                        width: dp(44)
                        color: .20, .16, .12, 1
                        on_active: root.toggle_all_sources(self.active)

                    Label:
                        text: 'Выбрать все'
                        color: .08, .07, .06, 1
                        font_size: '16sp'
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                BoxLayout:
                    id: sources_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(7)

                Label:
                    text: 'Количество вопросов'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                    text_size: self.width, None
                    halign: 'left'

                TextInput:
                    id: question_count
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: 'Время тестирования, минут'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                    text_size: self.width, None
                    halign: 'left'

                TextInput:
                    id: test_minutes
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: 'Условие успешного прохождения, %'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                    text_size: self.width, None
                    halign: 'left'

                TextInput:
                    id: pass_percent
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: root.message
                    color: (.12, .48, .18, 1) if root.message == 'Настройки сохранены' else (.70, .12, .10, 1)
                    font_size: '14sp'
                    size_hint_y: None
                    height: dp(30) if root.message else 0.01
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

                Button:
                    text: 'Сохранить настройки'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    background_normal: ''
                    background_down: ''
                    background_color: .83, .73, .61, 1
                    size_hint_y: None
                    height: dp(60)
                    on_release: root.save_settings()

                Button:
                    text: 'Назад'
                    color: .08, .07, .06, 1
                    font_size: '16sp'
                    background_normal: ''
                    background_down: ''
                    background_color: .82, .82, .80, 1
                    size_hint_y: None
                    height: dp(54)
                    on_release: root.go_back()
